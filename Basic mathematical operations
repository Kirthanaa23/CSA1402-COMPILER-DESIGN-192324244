%{
#include <stdio.h>
#include <stdlib.h>
#include <math.h>

int op = 0, i;
float a = 0, b = 0;
int digi();
%}

digit      ([0-9]+(\.[0-9]+)?)     // Matches integers or floating-point numbers
add        \+
sub        \-
mul        \*
div        /
pow        \^
ln         \n
ws         [ \t]+

%%
{ws}            ;   // Ignore whitespace
{digit}         { digi(); }
{add}           { op = 1; }
{sub}           { op = 2; }
{mul}           { op = 3; }
{div}           { op = 4; }
{pow}           { op = 5; }
{ln}            { printf("\nThe Answer: %.3f\n\n", a); a = 0; op = 0; } 
.               { printf("Invalid character: %s\n", yytext); }

%%

int digi()
{
    if (op == 0)
        a = atof(yytext);
    else {
        b = atof(yytext);
        switch(op) {
            case 1: a = a + b; break;
            case 2: a = a - b; break;
            case 3: a = a * b; break;
            case 4: 
                if (b != 0)
                    a = a / b; 
                else
                    printf("Error: Division by zero\n");
                break;
            case 5: a = pow(a, b); break;
        }
        op = 0;
    }
    return 0;
}

int main()
{
    yylex();
    return 0;
}

int yywrap()
{
    return 1;
}

