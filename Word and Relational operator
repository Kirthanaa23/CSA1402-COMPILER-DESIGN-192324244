%{
#include <stdio.h>
%}

%%
[a-zA-Z_][a-zA-Z0-9_]*     { printf("WORD: %s\n", yytext); }

"=="                       { printf("RELATIONAL OPERATOR: ==\n"); }
"!="                       { printf("RELATIONAL OPERATOR: !=\n"); }
"<="                       { printf("RELATIONAL OPERATOR: <=\n"); }
">="                       { printf("RELATIONAL OPERATOR: >=\n"); }
"<"                        { printf("RELATIONAL OPERATOR: <\n"); }
">"                        { printf("RELATIONAL OPERATOR: >\n"); }

[ \t\n]+                   { /* skip whitespace */ }

.                          { printf("UNKNOWN: %s\n", yytext); }

%%

int main() {
    yylex();
    return 0;
}

OUTPUT:
int x = 10;
if (x >= 5) {
    x == 5;
}
WORD: int
WORD: x
RELATIONAL OPERATOR: ==
NUMBER: 10
RELATIONAL OPERATOR: >=
NUMBER: 5
RELATIONAL OPERATOR: ==
UNKNOWN: ;
UNKNOWN: {
UNKNOWN: }
